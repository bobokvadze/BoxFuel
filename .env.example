# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic - no longer used (both features run on Gemini now). Safe to delete this line.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Google Gemini (aistudio.google.com/apikey) - powers both the food photo scan and the coach tip.
GEMINI_API_KEY=your-gemini-key
# Optional overrides if Google renames/retires a version later.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_TIP=gemini-3.6-flash
